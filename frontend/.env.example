# Backend API base URL (set to your Render service URL in production)
VITE_API_URL=https://your-backend.onrender.com/api

# Socket.io server URL (same host as backend, without /api)
VITE_SOCKET_URL=https://your-backend.onrender.com

# UPI ID shown on the payment page (optional)
VITE_UPI_ID=yourname@upi
